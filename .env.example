# Server Environment Configuration
NODE_ENV=development
PORT=3000
APP_VERSION=local
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=https://ophireummultimedia.com,https://www.ophireummultimedia.com,https://ophireumtechnology.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Required for stable signed admin sessions in production. Generate at least 32 random bytes.
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_ALLOWLIST_EMAILS=

# Server-side provider credentials; never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Public frontend configuration only.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
