# ============================================================================
# OPHIREUM NETWORK (OMPNETWORK) — Environment Variable Register (Placeholders Only)
# Keep all server secrets exclusively in Railway / GitHub Actions Secrets.
# NEVER commit real .env files or expose server secrets through VITE_* variables.
# ============================================================================

# --- Runtime & Networking ---
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0-rc.2
APP_BASE_URL=https://ophireummultimedia.com
ALLOWED_ORIGINS=https://ophireummultimedia.com,https://www.ophireummultimedia.com,https://ophireumtechnology.github.io
RAILWAY_PUBLIC_DOMAIN=api.ophireummultimedia.com
RAILWAY_REPLICA_ID=

# --- Frontend Public Build Variables (Safe for Client Bundle) ---
VITE_API_BASE_URL=https://api.ophireummultimedia.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Primary Database: Native Railway PostgreSQL (Recommended) ---
DATABASE_PROVIDER=auto
DATABASE_URL=
DATABASE_SSL=false
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
PG_SLOW_QUERY_MS=500

# --- Transitional / Private Storage: Supabase (Optional when DATABASE_PROVIDER=postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication, Session Signing & MFA Encryption ---
ADMIN_SESSION_SECRET=
PORTAL_SIGNING_SECRET=
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_PREVIOUS=
REQUIRE_ADMIN_MFA=true
ADMIN_ALLOWLIST_EMAILS=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_MFA_SECRET=
ADMIN_NOTIFICATION_EMAIL=

# --- Google Gemini AI & Cost Governance (Server-Side Only) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-4-hydrogen
GEMINI_REASONING_MODEL=gemini-4-neon
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ALLOW_TEST_HASH_EMBEDDINGS=false
AI_MAX_TOKENS_PER_REQUEST=8192
AI_DAILY_SPEND_CAP_USD=25
AI_MONTHLY_SPEND_CAP_USD=500
AI_MAX_CONCURRENT_EXECUTIONS=10
AI_EMERGENCY_SUSPENDED=false

# --- Transactional Email (Resend) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

# --- Consultation Scheduling (Google Calendar) ---
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Authorized Payment Sandboxes (live_payments_enabled remains hard-locked FALSE) ---
XENDIT_SECRET_KEY_TEST=
XENDIT_WEBHOOK_TOKEN_TEST=
PAYPAL_CLIENT_ID_SANDBOX=
PAYPAL_CLIENT_SECRET_SANDBOX=
PAYPAL_WEBHOOK_SECRET_SANDBOX=
MAYA_PUBLIC_KEY_SANDBOX=
MAYA_SECRET_KEY_SANDBOX=
MAYA_WEBHOOK_SECRET_SANDBOX=
CARD_GATEWAY_SECRET_KEY_TEST=
CARD_GATEWAY_WEBHOOK_SECRET_TEST=

# --- Deferred Payment Providers (Intentionally Disabled: deferred_merchant_onboarding) ---
PAYMONGO_SECRET_KEY_TEST=
PAYMONGO_WEBHOOK_SECRET_TEST=
GOTYME_API_SECRET_TEST=
GOTYME_WEBHOOK_SECRET_TEST=