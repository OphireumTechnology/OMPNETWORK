# Server Environment Configuration (NEVER expose server secrets with VITE_ prefix)
NODE_ENV=development
PORT=3000
APP_VERSION=phase1-stabilization
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://ophireummultimedia.com

# Google Gemini AI (Server-Side Only)
GEMINI_API_KEY=

# Supabase PostgreSQL Persistence & Auth Verification
# SUPABASE_SERVICE_ROLE_KEY is strictly server-side; never expose in browser bundles
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Public Configuration
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin Authentication & Session Signing (Server-Side Only)
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_ALLOWLIST_EMAILS=

# Transactional Email Provider (Resend)
RESEND_API_KEY=
EMAIL_FROM="Ophireum Multimedia Production <no-reply@ophireummultimedia.com>"
ADMIN_NOTIFICATION_EMAIL=ophireum.multimedia@gmail.com

# Optional Google Calendar Integration (Server-Side Service Account JSON string)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=