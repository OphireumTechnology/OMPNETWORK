{
  "name": "ophireum-network",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server/index.mjs",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.mjs",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','dist-server','server.js']) fs.rmSync(p,{recursive:true,force:true});\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 src server.ts tests e2e playwright.config.ts",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:migrate:dry-run": "node scripts/run-migrations.mjs --dry-run",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/phase1-stabilization.test.ts tests/client-portal.test.ts tests/commerce-subscriptions-fulfillment.test.ts tests/deployment-integration.test.ts tests/enterprise-remediation.test.ts tests/ai-workforce-functional.test.ts tests/ai-conversation-live-voice.test.ts tests/enterprise-phases31-46.test.ts",
    "test:security": "node --import tsx --test tests/security-negative.test.ts tests/enterprise-phases31-46.test.ts",
    "test:migrations": "node --import tsx --test tests/postgres-migrations.test.ts",
    "test:pg": "node --import tsx --test tests/native-postgres-integration.test.ts",
    "smoke:prod": "node scripts/prod-smoke-check.mjs",
    "sbom": "node scripts/generate-release-manifest.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@supabase/supabase-js": "^2.119.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.0"
  }
}
